<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 (API 33) moved the Wi-Fi APIs off the location permission onto their own
         runtime permission, and startLocalOnlyHotspot() is one of them: without this, a Tiramisu+
         device throws "does not have nearby devices permission" no matter how thoroughly
         ACCESS_FINE_LOCATION is granted. neverForLocation asserts what is actually true here — the
         hotspot is used to carry mesh traffic, never to work out where the phone is. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Pre-33, the same call is gated on location instead. Declared without maxSdkVersion because
         the bitchat-ble module declares it unconditionally too, and two modules asking for one
         permission with different maxSdkVersion values is a manifest-merge conflict. The runtime
         code below asks for whichever one the running API level actually wants. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- startLocalOnlyHotspot() needs this on every API level, and it is also what the pre-API-29
         join fallback (WifiConfiguration + addNetwork) uses. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
</manifest>
