<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ (API 31) split BLE out of the location permission group. Declaring both sets,
         with maxSdkVersion on the legacy ones, keeps older devices working without asking newer
         ones for location they do not need. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- No maxSdkVersion here (unlike BLUETOOTH/BLUETOOTH_ADMIN above): the wifi-hotspot module
         also declares this permission, unconditionally, because WifiManager.startLocalOnlyHotspot()
         needs it on every API level with no BLE-style exemption. Two manifests requesting the same
         permission with DIFFERENT maxSdkVersion values is a manifest-merge conflict, so both request
         it the same way — harmless for BLE, which only ever needed it pre-31 anyway. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- getLocalIpAddress() asks ConnectivityManager which network this phone is actually routed
         through, so it reports the real Wi-Fi LAN address instead of guessing from interface
         order. This is a normal (install-time) permission, not a runtime one. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- neverForLocation lets us scan without holding a location permission: this mesh only cares
         which peers are reachable, never where they are. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="s" />

    <!-- BLE is required for this feature, but not for the app, so the install is not restricted. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
</manifest>
