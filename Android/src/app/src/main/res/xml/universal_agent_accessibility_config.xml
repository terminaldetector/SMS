<!--
  Window-level events only (not typeAllMask): listScreenElements() pulls a fresh node tree from
  rootInActiveWindow on demand rather than consuming a continuous event stream, so nothing here
  needs to react to individual clicks/scrolls/text-changes as they happen.
  isAccessibilityTool is deliberately left unset (defaults false) — this service exists for
  LLM-driven automation, not to assist users with disabilities, and setting it true purely to
  reduce the OS's enablement friction would be dishonest.
  android:packageNames is deliberately left unset (all packages) per the explicit full-device-scope
  this feature was built for.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:notificationTimeout="100"
    android:description="@string/universal_agent_accessibility_service_description" />
